Bundle-Name: Liferay Chess API
Bundle-SymbolicName: com.liferay.chess.api
Bundle-Version: 2.3.0
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.segments.lang)";\
		resource.bundle.base.name="content.Language"
Require-Capability:\
	liferay.resource.bundle;\
		filter:="(bundle.symbolic.name=com.liferay.segments.lang)"